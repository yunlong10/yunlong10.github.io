<div id="selected-publications" class="publications">
  <div class="publication-cards">
    {% selected_bibliography_sorted --group_by none --query @*[selected=true]* %}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('selected-publications');
    var select = document.getElementById('pub-sort-by');
    if (!root || !select) return;

    var starMapCache = null;
    var starMapPromise = null;
    var initialOrder = new Map();

    root.querySelectorAll('.publication-cards ol.bibliography').forEach(function (list) {
      Array.prototype.forEach.call(list.children, function (el, idx) {
        if (el.tagName === 'LI') initialOrder.set(el, idx);
      });
    });

    /** Handles plain integers, commas, and compact k/m (YAML or shields-style). */
    function parseCount(val) {
      if (val == null || val === '') return 0;
      var s = String(val).trim().replace(/,/g, '');
      var lower = s.toLowerCase();
      if (lower.endsWith('k')) {
        var k = parseFloat(lower.slice(0, -1));
        return isNaN(k) ? 0 : Math.round(k * 1000);
      }
      if (lower.endsWith('m')) {
        var m = parseFloat(lower.slice(0, -1));
        return isNaN(m) ? 0 : Math.round(m * 1e6);
      }
      var n = parseInt(s, 10);
      return isNaN(n) ? 0 : n;
    }

    function citesForRow(row) {
      if (!row) return 0;
      return parseCount(row.getAttribute('data-sort-cites'));
    }

    function starsForRow(row) {
      if (!row) return 0;
      var repo = row.getAttribute('data-github-repo');
      if (repo && starMapCache && Object.prototype.hasOwnProperty.call(starMapCache, repo)) {
        return starMapCache[repo];
      }
      return parseCount(row.getAttribute('data-sort-stars'));
    }

    function yearForRow(row) {
      if (!row) return 0;
      var y = parseInt(row.getAttribute('data-sort-year'), 10);
      return isNaN(y) ? 0 : y;
    }

    function authorPosForRow(row) {
      if (!row) return 999;
      var p = parseInt(row.getAttribute('data-sort-author-pos'), 10);
      return isNaN(p) ? 999 : p;
    }

    // The Code buttons show shields' rounded count ("3.3k"); without one they read just "Code".
    function showStars(repo, label) {
      root.querySelectorAll('.gh-stars').forEach(function (el) {
        if (el.getAttribute('data-repo') !== repo) return;
        if (label && /^\d[\d.,]*[km]?$/i.test(label)) el.textContent = label;
        else el.parentElement.hidden = true;
      });
    }

    function ensureStarMap() {
      if (starMapCache) return Promise.resolve(starMapCache);
      if (starMapPromise) return starMapPromise;
      var repos = [];
      root.querySelectorAll('.row[data-github-repo]').forEach(function (r) {
        var repo = r.getAttribute('data-github-repo');
        if (repo && repos.indexOf(repo) === -1) repos.push(repo);
      });
      if (!repos.length) {
        starMapCache = {};
        return Promise.resolve(starMapCache);
      }
      starMapPromise = Promise.all(
        repos.map(function (repo) {
          var u = 'https://img.shields.io/github/stars/' + repo + '.json';
          return fetch(u, { cache: 'default' })
            .then(function (r) {
              return r.json();
            })
            .then(function (j) {
              showStars(repo, j && String(j.message));
              return { repo: repo, n: parseCount(j && j.message) };
            })
            .catch(function () {
              showStars(repo, null);
              return { repo: repo, n: 0 };
            });
        })
      ).then(function (pairs) {
        starMapCache = {};
        pairs.forEach(function (p) {
          starMapCache[p.repo] = p.n;
        });
        return starMapCache;
      });
      return starMapPromise;
    }

    function sortList(criterion) {
      root.querySelectorAll('.publication-cards').forEach(function (wrap) {
        var list = wrap.querySelector('ol.bibliography');
        if (!list) return;
        var items = Array.prototype.filter.call(list.children, function (el) {
          return el.tagName === 'LI';
        });
        if (criterion === 'default') {
          items.sort(function (a, b) {
            return (initialOrder.get(a) || 0) - (initialOrder.get(b) || 0);
          });
          items.forEach(function (li) {
            list.appendChild(li);
          });
          return;
        }
        items.sort(function (a, b) {
          var ra = a.querySelector('.row');
          var rb = b.querySelector('.row');
          var ca = citesForRow(ra);
          var cb = citesForRow(rb);
          var sa = starsForRow(ra);
          var sb = starsForRow(rb);
          var ya = yearForRow(ra);
          var yb = yearForRow(rb);
          var pa = authorPosForRow(ra);
          var pb = authorPosForRow(rb);
          var cmp;
          if (criterion === 'cites') {
            cmp = cb - ca;
            if (cmp !== 0) return cmp;
            cmp = pa - pb;
            if (cmp !== 0) return cmp;
            cmp = sb - sa;
            if (cmp !== 0) return cmp;
            return yb - ya;
          }
          if (criterion === 'authorpos') {
            cmp = pa - pb;
            if (cmp !== 0) return cmp;
            cmp = cb - ca;
            if (cmp !== 0) return cmp;
            cmp = sb - sa;
            if (cmp !== 0) return cmp;
            return yb - ya;
          }
          if (criterion === 'stars') {
            cmp = sb - sa;
            if (cmp !== 0) return cmp;
            cmp = cb - ca;
            if (cmp !== 0) return cmp;
            return yb - ya;
          }
          if (criterion === 'year') {
            cmp = yb - ya;
            if (cmp !== 0) return cmp;
            cmp = cb - ca;
            if (cmp !== 0) return cmp;
            return sb - sa;
          }
          cmp = cb - ca;
          if (cmp !== 0) return cmp;
          cmp = sb - sa;
          if (cmp !== 0) return cmp;
          return yb - ya;
        });
        items.forEach(function (li) {
          list.appendChild(li);
        });
      });
    }

    select.addEventListener('change', function () {
      var c = select.value;
      if (c !== 'default' && c !== 'year' && c !== 'cites' && c !== 'authorpos' && c !== 'stars') c = 'default';
      if (c === 'stars') {
        ensureStarMap().then(function () {
          sortList('stars');
        });
      } else {
        sortList(c);
      }
    });

    ensureStarMap().catch(function () {});
  })();

  // Masonry, as in the gallery: each visible card goes into the shortest of as many
  // ~340px columns as fit. research.js and bibsearch narrow and reorder the list (hidden,
  // .unloaded, moved <li>s) and cards change height (teasers loading, Abs/Bib opening),
  // so this follows the list rather than being called by them.
  (function () {
    var root = document.getElementById('selected-publications');
    if (!root) return;
    var gap = 24;
    var target = 340;
    var frame = 0;

    function layout(list) {
      var width = list.clientWidth;
      if (!width) return;
      var items = Array.prototype.filter.call(list.children, function (li) {
        return li.tagName === 'LI' && !li.hidden && !li.classList.contains('unloaded');
      });
      var cols = Math.max(1, Math.floor((width + gap) / (target + gap)));
      var colWidth = (width - (cols - 1) * gap) / cols;
      var colHeights = [];
      for (var c = 0; c < cols; c++) colHeights.push(0);
      // The observer below watches class changes; adding a class that's already there still
      // counts as one, so only add it once.
      if (!list.classList.contains('is-masonry')) list.classList.add('is-masonry');
      items.forEach(function (li) {
        li.style.width = colWidth + 'px';
      });
      var heights = items.map(function (li) {
        return li.offsetHeight;
      });
      items.forEach(function (li, i) {
        var min = 0;
        for (var c = 1; c < cols; c++) {
          if (colHeights[c] < colHeights[min]) min = c;
        }
        li.style.transform = 'translate(' + min * (colWidth + gap) + 'px,' + colHeights[min] + 'px)';
        colHeights[min] += heights[i] + gap;
      });
      list.style.height = Math.max(0, Math.max.apply(null, colHeights) - gap) + 'px';
      if (items.length && !list.classList.contains('is-masonry-ready')) {
        window.requestAnimationFrame(function () {
          list.classList.add('is-masonry-ready');
        });
      }
    }

    function layoutAll() {
      root.querySelectorAll('.publication-cards ol.bibliography').forEach(layout);
    }

    function requestLayout() {
      if (frame) return;
      frame = window.requestAnimationFrame(function () {
        frame = 0;
        layoutAll();
      });
    }

    var resizeObserver = 'ResizeObserver' in window ? new ResizeObserver(requestLayout) : null;
    root.querySelectorAll('.publication-cards ol.bibliography').forEach(function (list) {
      // Synchronously, so the paper panel's open animation (research.js) measures the
      // laid-out height.
      new MutationObserver(layoutAll).observe(list, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['hidden', 'class'],
      });
      if (resizeObserver) {
        resizeObserver.observe(list);
        Array.prototype.forEach.call(list.children, function (li) {
          resizeObserver.observe(li);
        });
      }
    });
    if (!resizeObserver) window.addEventListener('resize', requestLayout);
    window.addEventListener('load', requestLayout);
    layoutAll();
  })();
</script>
