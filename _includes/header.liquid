<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% assign navbar_avatar_path = '' %}
      {% for file in site.static_files %}
        {% assign avatar_path = file.path | downcase %}
        {% if avatar_path contains '/assets/img/website/' %}
          {% if avatar_path contains '.jpg'
            or avatar_path contains '.jpeg'
            or avatar_path contains '.png'
            or avatar_path contains '.webp'
            or avatar_path contains '.gif'
          %}
            {% if navbar_avatar_path == '' %}
              {% assign navbar_avatar_path = file.path | relative_url %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}
      <button type="button" class="navbar-menu-avatar" aria-label="Open links" aria-controls="profile-drawer" aria-expanded="false">
        <img
          {% if navbar_avatar_path != '' %}
            src="{{ navbar_avatar_path }}"
          {% endif %}
          alt=""
          aria-hidden="true"
        >
      </button>
      <a class="navbar-brand title font-weight-lighter navbar-brand-centered" href="{{ site.baseurl }}/">
        <span class="font-weight-bold">Yolo</span>
        Tang
      </a>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{{ child.permalink | relative_url }}">
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                {% assign is_active_page = false %}
                {% if parent_link == '/' %}
                  {% if page.url == '/' %}
                    {% assign is_active_page = true %}
                  {% endif %}
                {% elsif page.url contains parent_link %}
                  {% assign is_active_page = true %}
                {% endif %}
                <li class="nav-item {% if is_active_page %}active{% endif %}">
                  {% if p.permalink contains '/blog/' %}{% assign url = '/blog/' %} {% else %}{% assign url = p.url %}{% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if is_active_page %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% if site.enable_darkmode %}
        <!-- Toggle theme mode -->
        <div class="toggle-container navbar-theme-toggle">
          <button id="light-toggle" title="Change theme">
            <i class="ti ti-device-desktop" id="light-toggle-system"></i>
            <i class="ti ti-sun" id="light-toggle-light"></i>
            <i class="ti ti-moon" id="light-toggle-dark"></i>
          </button>
        </div>
      {% endif %}
    </div>
  </nav>
  <div class="profile-drawer-backdrop" hidden></div>
  <aside id="profile-drawer" class="profile-drawer" role="dialog" aria-modal="true" aria-label="Yolo's links" hidden>
    <div class="profile-drawer-head">
      <button type="button" class="profile-drawer-photo" aria-label="Show profile photo">
        <img
          {% if navbar_avatar_path != '' %}
            src="{{ navbar_avatar_path }}"
          {% endif %}
          alt=""
        >
      </button>
      <div class="profile-drawer-name"><span>Yolo</span> Tang</div>
      <button type="button" class="profile-drawer-close" aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    {% if site.search_enabled %}
      <button
        type="button"
        class="profile-drawer-search"
        aria-label="Search the site"
        data-papers-url="{{ '/assets/json/search-papers.json' | relative_url }}"
        data-gallery-url="{{ '/assets/json/search-gallery.json' | relative_url }}"
        data-home-url="{{ '/' | relative_url }}"
      >
        <i class="ti ti-search" aria-hidden="true"></i>
        <span>Search papers, illustrations…</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
      </button>
    {% endif %}
    <nav class="profile-drawer-links" aria-label="Links">
      <section>
        <h2>Explore</h2>
        <a href="{{ '/?panel=research' | relative_url }}" data-drawer-panel="research">
          <i class="fa-regular fa-compass" aria-hidden="true"></i><span>Research</span>
        </a>
        <a href="{{ '/?panel=blog' | relative_url }}" data-drawer-panel="blog">
          <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i><span>Yo'Log</span>
        </a>
        <a href="{{ '/?panel=gallery' | relative_url }}" data-drawer-panel="gallery">
          <i class="fa-regular fa-images" aria-hidden="true"></i><span>Gallery</span>
        </a>
      </section>
      <section>
        <h2>Academic</h2>
        <a href="{{ '/news/' | relative_url }}"> <i class="fa-regular fa-newspaper" aria-hidden="true"></i><span>News</span> </a>
        <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener noreferrer">
          <i class="ai ai-google-scholar" aria-hidden="true"></i><span>Google Scholar</span>
        </a>
        <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-github" aria-hidden="true"></i><span>GitHub</span><small>@{{ site.github_username }}</small>
        </a>
        <a href="https://x.com/{{ site.x_username }}" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-x-twitter" aria-hidden="true"></i><span>X</span><small>@{{ site.x_username }}</small>
        </a>
        <a href="mailto:{{ site.email | encode_email }}"> <i class="fa-regular fa-envelope" aria-hidden="true"></i><span>Email</span> </a>
      </section>
      <section>
        <h2>Creative</h2>
        <a href="https://www.instagram.com/{{ site.instagram_id }}/" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-instagram" aria-hidden="true"></i><span>Instagram</span><small>@{{ site.instagram_id }}</small>
        </a>
        <a href="https://pixiv.me/yoloytang" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="#0096FA" d="M4.935 0A4.924 4.924 0 0 0 0 4.935v14.13A4.924 4.924 0 0 0 4.935 24h14.13A4.924 4.924 0 0 0 24 19.065V4.935A4.924 4.924 0 0 0 19.065 0zm7.81 4.547c2.181 0 4.058.676 5.399 1.847a6.118 6.118 0 0 1 2.116 4.66c.005 1.854-.88 3.476-2.257 4.563-1.375 1.092-3.225 1.697-5.258 1.697-2.314 0-4.46-.842-4.46-.842v2.718c.397.116 1.048.365.635.779H5.79c-.41-.41.19-.65.644-.779V7.666c-1.053.81-1.593 1.51-1.868 2.031.32 1.02-.284.969-.284.969l-1.09-1.73s3.868-4.39 9.553-4.39zm-.19.971c-1.423-.003-3.184.473-4.27 1.244v8.646c.988.487 2.484.832 4.26.832h.01c1.596 0 2.98-.593 3.93-1.533.952-.948 1.486-2.183 1.492-3.683-.005-1.54-.504-2.864-1.42-3.86-.918-.992-2.274-1.645-4.002-1.646Z"/>
          </svg>
          <span>Pixiv</span><small>@yoloytang</small>
        </a>
        <a href="https://x.com/yoloytang_art" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-x-twitter" aria-hidden="true"></i><span>X</span><small>@yoloytang_art</small>
        </a>
        <a href="https://discord.com/users/1152784980167106662" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-discord" aria-hidden="true"></i><span>Discord</span>
        </a>
      </section>
      <section>
        <h2>Meow</h2>
        <a href="https://telegram.me/yoloytang" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-telegram" aria-hidden="true"></i><span>Telegram</span><small>@yoloytang</small>
        </a>
      </section>
    </nav>
    {% include visitor_map.liquid %}
    <p class="profile-drawer-copyright">
      &copy; Copyright {{ site.time | date: '%Y' }} Yolo Tang. {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </p>
  </aside>
  <div id="navbar-avatar-modal" class="navbar-avatar-modal" aria-hidden="true">
    <img
      {% if navbar_avatar_path != '' %}
        src="{{ navbar_avatar_path }}"
      {% endif %}
      alt="Profile photo"
    >
  </div>
  <script>
    (function () {
      var avatarButton = document.querySelector('.navbar-menu-avatar');
      var avatarModal = document.getElementById('navbar-avatar-modal');
      if (!avatarButton || !avatarModal) return;
      var avatarImage = avatarButton.querySelector('img');
      var avatarModalImage = avatarModal.querySelector('img');
      var drawer = document.getElementById('profile-drawer');
      var drawerBackdrop = document.querySelector('.profile-drawer-backdrop');
      var drawerPhoto = drawer ? drawer.querySelector('.profile-drawer-photo img') : null;
      var drawerHideTimer = null;
      var avatarImages = [];
      var currentAvatar = '';
      {% for file in site.static_files %}
        {% assign avatar_path = file.path | downcase %}
        {% if avatar_path contains '/assets/img/website/' %}
          {% if avatar_path contains '.jpg' or avatar_path contains '.jpeg' or avatar_path contains '.png' or avatar_path contains '.webp' or avatar_path contains '.gif' %}
            avatarImages.push('{{ file.path | relative_url }}');
          {% endif %}
        {% endif %}
      {% endfor %}

      function pickAvatar(excludedAvatar) {
        var selectedAvatar = avatarImages[Math.floor(Math.random() * avatarImages.length)];
        if (avatarImages.length > 1 && selectedAvatar === excludedAvatar) {
          selectedAvatar = avatarImages[(avatarImages.indexOf(selectedAvatar) + 1) % avatarImages.length];
        }
        return selectedAvatar;
      }

      function rememberAvatar(selectedAvatar) {
        try {
          window.sessionStorage.setItem('navbarAvatar', selectedAvatar);
        } catch (e) {
          // Private browsing or blocked storage should not affect avatar rendering.
        }
      }

      function setAvatar(selectedAvatar) {
        currentAvatar = selectedAvatar;
        avatarImage.src = selectedAvatar;
        if (drawerPhoto) drawerPhoto.src = selectedAvatar;
        rememberAvatar(selectedAvatar);
      }

      if (avatarImages.length && avatarImage && avatarModalImage) {
        var previousAvatar = '';
        try {
          previousAvatar = window.sessionStorage.getItem('navbarAvatar') || '';
        } catch (e) {
          previousAvatar = '';
        }
        setAvatar(pickAvatar(previousAvatar));
      }

      function closeAvatarModal() {
        avatarModal.classList.remove('active');
        avatarModal.setAttribute('aria-hidden', 'true');
      }

      // Shows the current photo, then rotates the navbar avatar for next time.
      function showProfilePhoto() {
        if (currentAvatar && avatarModalImage) avatarModalImage.src = currentAvatar;
        avatarModal.classList.add('active');
        avatarModal.setAttribute('aria-hidden', 'false');
        if (avatarImages.length && avatarImage) setAvatar(pickAvatar(currentAvatar));
      }
      // The gallery's profile avatar opens the photo directly.
      window.showProfilePhoto = showProfilePhoto;

      function isDrawerOpen() {
        return !!drawer && drawer.classList.contains('is-open');
      }

      function openDrawer() {
        if (!drawer || isDrawerOpen()) return;
        window.clearTimeout(drawerHideTimer);
        drawer.hidden = false;
        drawerBackdrop.hidden = false;
        document.documentElement.classList.add('has-profile-drawer');
        avatarButton.setAttribute('aria-expanded', 'true');
        window.requestAnimationFrame(function () {
          drawer.classList.add('is-open');
          drawerBackdrop.classList.add('is-open');
        });
        drawer.querySelector('.profile-drawer-close').focus();
      }

      function closeDrawer() {
        if (!isDrawerOpen()) return;
        drawer.classList.remove('is-open');
        drawerBackdrop.classList.remove('is-open');
        document.documentElement.classList.remove('has-profile-drawer');
        avatarButton.setAttribute('aria-expanded', 'false');
        avatarButton.focus();
        drawerHideTimer = window.setTimeout(function () {
          drawer.hidden = true;
          drawerBackdrop.hidden = true;
        }, 320);
      }

      avatarButton.addEventListener('click', function () {
        if (drawer) openDrawer();
        else showProfilePhoto();
      });

      // Site search behind the homepage card's search mode (about.liquid):
      // window.siteSearch.attach(input, resultsEl, options). Covers what the
      // Cmd/Ctrl+K palette indexes (pages, posts, news, socials; scripts/search.liquid) plus
      // every paper in papers.bib and every gallery post (assets/json/search-papers.json and
      // search-gallery.json, fetched on first use).
      var searchConfig = document.querySelector('.profile-drawer-search');
      if (searchConfig) window.siteSearch = createSiteSearch(searchConfig);

      function createSiteSearch(config) {
        var sectionOrder = ['Papers', 'Navigation', 'Posts', 'Gallery', 'News'];
        var home = config.getAttribute('data-home-url');
        var papers = null;
        var paintings = [];
        var indexRequested = false;
        var waiting = [];

        function plainText(html) {
          var el = document.createElement('div');
          el.innerHTML = html || '';
          var text = el.textContent || '';
          // Some palette entries are escaped twice (e.g. "&amp;amp;").
          if (/&(#\d+|#x[0-9a-f]+|[a-z]+);/i.test(text)) {
            el.innerHTML = text;
            text = el.textContent || '';
          }
          return text.replace(/\s+/g, ' ').trim();
        }

        function fetchList(url) {
          return fetch(url)
            .then(function (response) {
              return response.json();
            })
            .catch(function () {
              return [];
            });
        }

        function loadIndex() {
          if (indexRequested) return;
          indexRequested = true;
          Promise.all([fetchList(config.getAttribute('data-papers-url')), fetchList(config.getAttribute('data-gallery-url'))]).then(
            function (lists) {
              papers = lists[0];
              paintings = lists[1];
              waiting.forEach(function (refresh) {
                refresh();
              });
            }
          );
        }

        function allItems() {
          var ninja = document.querySelector('ninja-keys');
          var site = ((ninja && ninja.data) || [])
            .filter(function (item) {
              // Inline news items have no page of their own; they open the news list.
              return item.section !== 'Theme' && (item.handler || item.section === 'News');
            })
            .map(function (item) {
              return {
                section: item.section,
                title: plainText(item.title),
                meta: plainText(item.description),
                run: item.handler,
                href: item.handler ? null : home + 'news/',
              };
            });
          var paperItems = (papers || []).map(function (paper) {
            var venue = [paper.venue, paper.year].filter(Boolean).join(' ');
            return {
              section: 'Papers',
              title: paper.title,
              meta: [venue, paper.authors].filter(Boolean).join(' \u00b7 '),
              // Selected papers are on the homepage: open its Research panel filtered to this one.
              href: paper.selected ? home + '?panel=research#' + encodeURIComponent(paper.title) : paper.url,
              external: !paper.selected,
            };
          });
          var galleryItems = paintings.map(function (painting) {
            return {
              section: 'Gallery',
              title: painting.title,
              meta: [painting.tags, painting.date].filter(Boolean).join(' \u00b7 '),
              // On the homepage the post opens in place; elsewhere via /?panel=gallery&painting=.
              run: window.showGalleryPainting
                ? function () {
                    window.showGalleryPainting(painting.id);
                  }
                : null,
              href: home + '?panel=gallery&painting=' + encodeURIComponent(painting.id),
            };
          });
          return paperItems.concat(site, galleryItems);
        }

        function search(query) {
          var words = query.toLowerCase().split(/\s+/).filter(Boolean);
          var matches = [];
          allItems().forEach(function (item, order) {
            var title = item.title.toLowerCase();
            var text = title + ' ' + item.meta.toLowerCase() + ' ' + item.section.toLowerCase();
            for (var w = 0; w < words.length; w++) {
              if (text.indexOf(words[w]) === -1) return;
            }
            var whole = query.toLowerCase();
            item.score = title.indexOf(whole) === 0 ? 0 : title.indexOf(whole) !== -1 ? 1 : 2;
            item.order = order;
            matches.push(item);
          });
          function rank(section) {
            var i = sectionOrder.indexOf(section);
            return i === -1 ? sectionOrder.length : i;
          }
          return matches
            .sort(function (a, b) {
              // News is indexed oldest first; show the latest first.
              var order = a.section === 'News' ? b.order - a.order : a.order - b.order;
              return rank(a.section) - rank(b.section) || a.score - b.score || order;
            })
            .slice(0, 40);
        }

        function open(item) {
          if (item.run) item.run(item);
          else if (item.external) window.open(item.href, '_blank', 'noopener');
          else if (item.href) window.location.href = item.href;
        }

        // Wires an input to a results element. options.live: re-search on every keystroke
        // (otherwise on Enter); options.onChoose: runs before a result is opened.
        function attach(input, results, options) {
          options = options || {};
          var idPrefix = (results.id || 'site-search') + '-option-';
          var shown = [];
          var active = -1;
          var lastQuery = '';

          function setActive(index) {
            var optionEls = results.querySelectorAll('[role="option"]');
            if (active >= 0 && optionEls[active]) optionEls[active].classList.remove('is-active');
            active = index;
            if (active >= 0 && optionEls[active]) {
              optionEls[active].classList.add('is-active');
              optionEls[active].scrollIntoView({ block: 'nearest' });
              input.setAttribute('aria-activedescendant', optionEls[active].id);
            } else {
              input.removeAttribute('aria-activedescendant');
            }
          }

          function hide() {
            results.hidden = true;
            results.innerHTML = '';
            input.setAttribute('aria-expanded', 'false');
            input.removeAttribute('aria-activedescendant');
            shown = [];
            active = -1;
            lastQuery = '';
          }

          function choose(item) {
            if (options.onChoose) options.onChoose(item);
            open(item);
          }

          function render() {
            var query = input.value.trim();
            if (!query) {
              hide();
              return;
            }
            loadIndex();
            lastQuery = query;
            shown = search(query);
            active = -1;
            results.innerHTML = '';
            if (!shown.length) {
              var empty = document.createElement('p');
              empty.className = 'site-search-empty';
              empty.textContent = papers ? 'No results for \u201c' + query + '\u201d' : 'Searching\u2026';
              results.appendChild(empty);
            }
            var lastSection = null;
            shown.forEach(function (item, i) {
              if (item.section !== lastSection) {
                lastSection = item.section;
                var heading = document.createElement('div');
                heading.className = 'site-search-group';
                heading.textContent = item.section;
                results.appendChild(heading);
              }
              var option = document.createElement('div');
              option.className = 'site-search-result';
              option.id = idPrefix + i;
              option.setAttribute('role', 'option');
              var title = document.createElement('span');
              title.className = 'site-search-result-title';
              title.textContent = item.title;
              option.appendChild(title);
              if (item.meta) {
                var meta = document.createElement('span');
                meta.className = 'site-search-result-meta';
                meta.textContent = item.meta;
                option.appendChild(meta);
              }
              option.addEventListener('mousemove', function () {
                if (active !== i) setActive(i);
              });
              option.addEventListener('mousedown', function (e) {
                e.preventDefault();
              });
              option.addEventListener('click', function () {
                choose(item);
              });
              results.appendChild(option);
            });
            results.hidden = false;
            input.setAttribute('aria-expanded', 'true');
          }

          // The paper index arrives later: refresh whatever is showing.
          waiting.push(function () {
            if (!results.hidden && lastQuery) render();
          });

          input.addEventListener('focus', loadIndex);
          if (options.live) input.addEventListener('input', render);
          input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              if (!shown.length) return;
              e.preventDefault();
              var step = e.key === 'ArrowDown' ? 1 : -1;
              setActive((active + step + shown.length) % shown.length);
            } else if (e.key === 'Enter') {
              e.preventDefault();
              // Enter opens the highlighted result; otherwise it searches (or, with fresh
              // live results, opens the first).
              var query = input.value.trim();
              if (active >= 0 && shown[active]) choose(shown[active]);
              else if (shown.length && query === lastQuery && options.live) choose(shown[0]);
              else render();
            }
          });

          return { render: render, hide: hide, load: loadIndex };
        }

        return { attach: attach, load: loadIndex };
      }

      // The drawer's box only launches search: it closes the drawer and puts the homepage
      // card into search mode (window.openPromptSearch, about.liquid), as its magnifier does.
      // Elsewhere it goes to the homepage with ?search to do the same. So does Cmd/Ctrl+K.
      function setupDrawerSearch() {
        var box = drawer.querySelector('.profile-drawer-search');
        if (!box) return;
        if (/mac/i.test(navigator.platform)) box.querySelector('kbd').textContent = '\u2318K';

        function launchSearch() {
          closeDrawer();
          if (typeof window.openPromptSearch === 'function') window.openPromptSearch();
          else window.location.href = box.getAttribute('data-home-url') + '?search';
        }

        box.addEventListener('click', launchSearch);
        document.addEventListener('keydown', function (e) {
          if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
          e.preventDefault();
          launchSearch();
        });
      }

      if (drawer) {
        drawer.querySelector('.profile-drawer-photo').addEventListener('click', showProfilePhoto);
        drawer.querySelector('.profile-drawer-close').addEventListener('click', closeDrawer);
        drawerBackdrop.addEventListener('click', closeDrawer);
        setupDrawerSearch();
        // On the homepage these open the panel in place; elsewhere they follow ?panel=.
        drawer.querySelectorAll('[data-drawer-panel]').forEach(function (link) {
          link.addEventListener('click', function (e) {
            var button = document.querySelector('.about-quick-links [data-about-panel-trigger="' + link.getAttribute('data-drawer-panel') + '"]');
            if (!button) return;
            e.preventDefault();
            closeDrawer();
            if (button.getAttribute('aria-expanded') !== 'true') button.click();
          });
        });
        // Keep Tab inside the open drawer.
        drawer.addEventListener('keydown', function (e) {
          if (e.key !== 'Tab') return;
          var focusables = drawer.querySelectorAll('a[href], button');
          var first = focusables[0];
          var last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });
      }

      avatarModal.addEventListener('click', function (e) {
        if (e.target === avatarModal) closeAvatarModal();
      });

      // Registered before the page's own Escape handlers (e.g. closing homepage panels),
      // so an open photo or drawer takes the keypress and stops it there.
      window.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (avatarModal.classList.contains('active')) {
          closeAvatarModal();
          e.stopImmediatePropagation();
        } else if (isDrawerOpen()) {
          closeDrawer();
          e.stopImmediatePropagation();
        }
      });
    })();
  </script>
  {% if site.enable_progressbar %}
    {% unless page.progressbar == false %}
      <!-- Scroll reading indicator: rainbow fill -->
      <div
        id="reading-progress"
        class="reading-progress"
        role="progressbar"
        aria-valuemin="0"
        aria-valuenow="0"
        aria-valuemax="100"
        aria-label="Reading progress"
        style="--reading-progress-pct: 0%;"
      >
        <div class="reading-progress-track" aria-hidden="true"></div>
        <div class="reading-progress-fill" aria-hidden="true"></div>
      </div>
    {% endunless %}
  {% endif %}
</header>
